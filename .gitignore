node_modules/

# Build output - Cloudflare Pages regenerates this on every deploy
public/assets/

# Wrangler local state (includes the local D1 sqlite file)
.wrangler/

# Never commit secrets
.dev.vars
.env

.DS_Store

# Backups and exports. These live outside the repo by rule, but a stray one
# written inside it must not be stageable. The negation keeps migrations
# tracked - they are real source, not an export.
*.zip
*.sql
!migrations/*.sql
