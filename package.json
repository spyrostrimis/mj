{
  "name": "mj",
  "version": "1.0.0",
  "description": "Monkey Journal - a private gratitude journal",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --format=iife --target=es2020 --jsx=automatic --outfile=public/assets/app.js",
    "dev": "npm run build && wrangler pages dev",
    "test": "node --test \"test/**/*.test.js\"",
    "db:migrate": "wrangler d1 migrations apply mj-journal --local",
    "db:status": "wrangler d1 migrations list mj-journal --local"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "wrangler": "^3.90.0"
  }
}
